class Enricher:
    def __init__(self):
        self.q = queue.Queue()
        self.cache = self._load_cache()
        self.offline_until = 0.0
        self.last_key = None
        self._oc_proc = None
        self.started = {}
        self.epoch = 0
        self.provider = self._load_provider()
        self._lock = threading.RLock()

    def _load_cache(self):
        try:
            with open(CACHE_FILE) as fh:
                data = json.load(fh)
            if not isinstance(data, dict):
                return {}
            # keep only the most recent 800 entries on load
            return {k: v for k, v in list(data.items())[-800:] if isinstance(v, dict)}
        except Exception:
            return {}

    def persist_cache(self):
        with self._lock:
            try:
                os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
                tmp = CACHE_FILE + ".tmp"
                with open(tmp, "w") as fh:
                    json.dump(self.cache, fh)
                os.replace(tmp, CACHE_FILE)
            except Exception as e:
                log(f"cache persist FAIL: {e}", "WARN")

    def _load_provider(self):
        p = load_cfg().get("provider", "")
        return p if p in PROVIDERS else ""

    def active_provider(self):
        with self._lock:
            prv = self.provider
        order = ([prv] if provider_enabled(prv) else []) \
            + [n for n in PROVIDERS if n != prv and provider_enabled(n)]
        return order[0] if order else ""

    def switch_provider(self, name):
        if name not in PROVIDERS or not provider_enabled(name):
            log(f"provider switch to {name} rejected (not configured)")
            return False
        with self._lock:
            self.provider = name
            self.offline_until = 0.0
        persist_cfg(provider=name)
        log(f"provider switched to {name}")
        return True

    def invalidate(self, key, artist, title, performer):
        with self._lock:
            self.epoch += 1
            self.cache.pop(key, None)
            self.started.pop(key, None)
        self.persist_cache()
        self.submit(key, artist, title, performer)

    def start(self):
        threading.Thread(target=self._worker, daemon=True).start()

    def blurb(self, key):
        with self._lock:
            return self.cache.get(key) if self.provider_matches(key) else None

    def provider_matches(self, key):
        with self._lock:
            item = self.cache.get(key)
            return (isinstance(item, dict) and item.get("provider") == self.provider
                    and not item.get("fail"))

    def pending(self, key):
        if not ai_configured():
            return False
        with self._lock:
            return self.last_key == key and not self.provider_matches(key)

    def submit(self, key, artist, title, performer):
        with self._lock:
            self.last_key = key
            if self.provider_matches(key):
                return
            self.started[key] = time.time()
        self.q.put((key, artist, title, performer))

    def elapsed(self, key):
        with self._lock:
            t = self.started.get(key)
        return int(time.time() - t) if t else 0

    def _worker(self):
        while True:
            key, artist, title, performer = self.q.get()
            with self._lock:
                epoch = self.epoch
            if not ai_configured():
                log("ai not configured, skipping enrichment")
                with self._lock:
                    self.cache[key] = {"work": "", "trivia": "", "wiki": "",
                                       "movement": 0, "provider": self.provider,
                                       "fail": True}
                    self.started.pop(key, None)
                continue
            if time.time() < self.offline_until:
                log(f"offline cooldown until {time.strftime('%H:%M:%S', time.localtime(self.offline_until))}, skipping")
                with self._lock:
                    self.cache[key] = {"work": "", "trivia": "", "wiki": "",
                                       "movement": 0, "provider": self.provider,
                                       "fail": True}
                    self.started.pop(key, None)
                continue
            t0 = time.time()
            log(f"enrich start: {artist!r} - {title!r}")
            item = self._ask(artist, title, performer)
            had_wiki = bool(item and item.get("wiki"))
            if item is None:
                with self._lock:
                    self.offline_until = time.time() + 120
                log("ALL providers failed -> offline 120s", "WARN")
                item = {"work": "", "trivia": "", "wiki": "", "movement": 0,
                        "fail": True}
            else:
                if item.get("wiki"):
                    surname = (artist.split("(")[0].split()[-1] if artist else "") or ""
                    wt0 = time.time()
                    item["wiki"] = self._resolve_wiki(item["wiki"], surname)
                    log(f"wiki resolve {item['wiki']!r} elapse={time.time()-wt0:.1f}s")
            with self._lock:
                self.started.pop(key, None)
                stale = epoch != self.epoch
            if stale:
                log("stale reply discarded (provider/selection changed)")
                continue
            with self._lock:
                item["provider"] = self.provider
                self.cache[key] = item
                # dict insertion order => pop(next(iter(...))) evicts the OLDEST
                # entry, never this just-written (newest) one.
                if len(self.cache) > 256:
                    self.cache.pop(next(iter(self.cache)))
            self.persist_cache()
            log(f"enrich done elapse={time.time()-t0:.1f}s "
                f"trivia={len(item.get('trivia') or '')}ch "
                f"work={bool(item.get('work'))} "
                f"wiki={had_wiki}->{bool(item.get('wiki'))}")

    def _ask(self, artist, title, performer):
        question = (
            f"Artist/Composer: {artist or 'unknown'} · "
            f"Tagged name: {title or 'unknown'} · "
            f"Performer (if present): {performer or 'none'}"
        )
        prompt = (
            "You enrich classical-radio metadata for a live classical radio stream.\n"
            + question + "\n"
            "Reply with ONLY a single raw JSON object, nothing else. No markdown, "
            "no code fences, no reasoning, no explanations, no text before or "
            "after. Use exactly this shape:\n"
            '{"movement": 0, "work": "", "wiki": "", "trivia": ""}\n'
            "Rules:\n"
            '- "movement": 1 ONLY if the tagged name is a movement, part, section '
            'or fragment of a larger complete work (e.g. "1. Allegro", "Adagio", '
            '"Finale", "Menuetto", "II."). A short standalone piece such as a '
            'mazurka, prelude, song, waltz or individual character piece IS the '
            'whole work: use 0 and leave "work" empty.\n'
            '- "work": the canonical name of the WHOLE work with opus/catalogue '
            'number, ONLY when "movement" is 1; otherwise "".\n'
            '- "wiki": the exact English Wikipedia article title of the whole work '
            'with its disambiguator, e.g. "Mazurkas, Op. 67 (Chopin)" or '
            '"Sonata da camera No. 3 (Corelli)"; if none exists return "".\n'
            '- "trivia": 6-9 short plain sentences that weave together BOTH '
            '(a) the composer — who they were, their era/place in music '
            'history, notable relations or legacy — and (b) the piece being '
            'played — date, catalogue number, structure/movements, dedication, '
            'premiere, notable performers or recordings, where one may have '
            'heard it. Flow naturally from one to the other (either order, no '
            'headings, no labels). Aim for 750-850 characters with a hard '
            'maximum of 850 — if your draft runs long, tighten it. Always end '
            'on a complete, natural final sentence; never trail off mid-thought.\n'
            "Output the JSON object and nothing else."
        )
        raw = self._llm(prompt)
        if raw is None:
            return None
        item = extract_json_item(raw)
        if not item["movement"]:
            item["work"] = ""
        item["trivia"] = elide((item["trivia"] or "").replace('"', ""))
        return item

    def _llm(self, prompt):
        order = ([self.provider] if provider_enabled(self.provider) else []) \
            + [n for n in PROVIDERS if n != self.provider and provider_enabled(n)]
        fns = {"opencode": self._llm_opencode, "ollama": self._llm_ollama,
               "openai": self._llm_openai}
        for name in order:
            t0 = time.time()
            out = fns[name](prompt)
            log(f"llm[{name}] elapse={time.time()-t0:.1f}s "
                f"len={len(out or '')} ok={bool(out)}")
            if out:
                return out
        return None

    def _llm_ollama(self, prompt):
        try:
            payload = {
                "model": OLLAMA_MODEL,
                "prompt": prompt,
                "stream": False,
                "options": {"temperature": 0.1, "num_predict": 1200,
                            "num_gpu": OLLAMA_GPU},
            }
            req = urllib.request.Request(
                api_endpoint(OLLAMA, "api/generate"),
                data=json.dumps(payload).encode(),
                headers={"Content-Type": "application/json"},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=OLLAMA_TIMEOUT) as r:
                data = json.loads(r.read().decode())
            try:
                ev = data.get("eval_count") or 0
                ed = data.get("eval_duration") or 1
                log(f"ollama: eval={ev}tok rate={ev/(ed/1e9):.1f} tok/s "
                    f"total={data.get('total_duration',0)/1e9:.1f}s "
                    f"load={data.get('load_duration',0)/1e9:.1f}s")
            except Exception:
                pass
            return (data.get("response") or "").strip() or None
        except Exception as e:
            log(f"ollama FAIL: {e}", "WARN")
            return None

    def _llm_openai(self, prompt):
        try:
            base = api_endpoint(API_BASE, "chat/completions")
            payload = {
                "model": API_MODEL,
                "messages": [
                    {"role": "system", "content":
                        "You are a helpful classical-music metadata assistant. "
                        "Reply ONLY with the requested JSON, no markdown."},
                    {"role": "user", "content": prompt},
                ],
                "temperature": 0.1,
                "max_tokens": 1200,
            }
            req = urllib.request.Request(
                base,
                data=json.dumps(payload).encode(),
                headers={"Content-Type": "application/json",
                         "Authorization": "Bearer " + API_KEY},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
                data = json.loads(r.read().decode())
            content = (data.get("choices") or [{}])[0].get("message", {}).get("content", "")
            return content.strip() or None
        except Exception as e:
            log(f"openai FAIL: {e}", "WARN")
            return None

    def _oc_health(self, port, timeout=2):
        try:
            with urllib.request.urlopen(
                    f"http://127.0.0.1:{port}/global/health", timeout=timeout) as r:
                return json.loads(r.read().decode()).get("healthy") is True
        except Exception:
            return False

    def _kill_pid(self, pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except Exception:
            return
        for _ in range(10):
            if not proc_alive(pid):
                return
            time.sleep(0.2)
        try:
            os.kill(pid, signal.SIGKILL)
        except Exception:
            pass

    def _oc_start(self, port):
        # Reclaim a wedged instance we spawned in a previous session instead of
        # stacking another `opencode serve` onto the same port.
        old_pid, old_port = read_pidfile()
        if old_pid and old_port == port and proc_alive(old_pid) \
                and not self._oc_health(port, timeout=3):
            log(f"stale opencode pid {old_pid} on :{port} wedged -> terminating", "WARN")
            self._kill_pid(old_pid)
            remove_pidfile()
        if port_in_use(port) and not self._oc_health(port, timeout=2):
            log(f":{port} held by an untracked listener and unhealthy; not spawning", "WARN")
            return False
        try:
            sd = open(SERVE_LOG, "a")
            self._oc_proc = subprocess.Popen(
                ["opencode", "serve", "--port", str(port), "--hostname", "127.0.0.1"],
                stdin=subprocess.DEVNULL, stdout=sd, stderr=sd)
            for _ in range(20):
                if self._oc_health(port):
                    write_pidfile(self._oc_proc.pid, port)
                    return True
                time.sleep(0.5)
            log(f"opencode serve on :{port} did not become healthy; see {SERVE_LOG}", "WARN")
            self._kill_pid(self._oc_proc.pid)
            remove_pidfile()
        except Exception as e:
            log(f"opencode spawn FAIL: {e}", "WARN")
        return False

    def _llm_opencode(self, prompt):
        port = oc_port()
        h0 = time.time()
        if not self._oc_health(port):
            log(f"opencode not on :{port}, spawning serve")
            if not self._oc_start(port):
                log("opencode unavailable", "WARN")
                return None
        log(f"opencode healthy (elapse={time.time()-h0:.1f}s), using :{port}")
        try:
            hdr = {"Content-Type": "application/json"}
            s0 = time.time()
            req = urllib.request.Request(
                f"http://127.0.0.1:{port}/session",
                data=json.dumps({"title": "mradio"}).encode(), headers=hdr, method="POST")
            with urllib.request.urlopen(req, timeout=10) as r:
                sid = json.loads(r.read().decode()).get("id")
            if not sid:
                log("opencode session create returned no id", "WARN")
                return None
            log(f"opencode session {sid} created in {time.time()-s0:.2f}s")
            try:
                m0 = time.time()
                req = urllib.request.Request(
                    f"http://127.0.0.1:{port}/session/{sid}/message",
                    data=json.dumps({"parts": [{"type": "text", "text": prompt}]}).encode(),
                    headers=hdr, method="POST")
                with urllib.request.urlopen(req, timeout=OC_TIMEOUT) as r:
                    data = json.loads(r.read().decode())
                texts = " ".join(
                    p.get("text", "") for p in data.get("parts", [])
                    if p.get("type") == "text" and p.get("text"))
                log(f"opencode message took {time.time()-m0:.1f}s, "
                    f"returned {len(data.get('parts') or [])} parts, {len(texts)} chars")
                return texts.strip() or None
            finally:
                try:
                    req = urllib.request.Request(
                        f"http://127.0.0.1:{port}/session/{sid}", method="DELETE")
                    urllib.request.urlopen(req, timeout=5)
                except Exception:
                    pass
        except Exception as e:
            log(f"opencode FAIL: {e}", "WARN")
            return None

    def shutdown(self):
        self.persist_cache()
        if getattr(self, "_oc_proc", None):
            try:
                self._oc_proc.terminate()
            except Exception:
                pass
            try:
                self._oc_proc.wait(timeout=2)
            except Exception:
                try:
                    self._oc_proc.kill()
                except Exception:
                    pass
            remove_pidfile()

    def _resolve_wiki(self, query, surname=""):
        ua = {"User-Agent": "mradio/0.3 (educational music enrichment) python-urllib"}
        cand = []
        try:
            qurl = ("https://en.wikipedia.org/w/api.php?action=opensearch&format=json"
                    "&limit=5&search=" + urllib.parse.quote(query))
            req = urllib.request.Request(qurl, headers=ua)
            with urllib.request.urlopen(req, timeout=10) as r:
                res = json.loads(r.read().decode())
            if len(res) > 3:
                cand.extend((res[1][i], res[3][i]) for i in range(min(len(res[1]), len(res[3]))))
        except Exception:
            pass
        if not cand:
            try:
                qurl = ("https://en.wikipedia.org/w/api.php?action=query&list=search&format=json"
                        "&srlimit=5&srsearch=" + urllib.parse.quote(query))
                req = urllib.request.Request(qurl, headers=ua)
                with urllib.request.urlopen(req, timeout=10) as r:
                    res = json.loads(r.read().decode())
                hits = res.get("query", {}).get("search", [])
                for h in hits:
                    t = h.get("title")
                    if not t:
                        continue
                    iurl = ("https://en.wikipedia.org/w/api.php?action=query&prop=info"
                            "&inprop=url&format=json&titles=" + urllib.parse.quote(t))
                    req = urllib.request.Request(iurl, headers=ua)
                    with urllib.request.urlopen(req, timeout=10) as r:
                        pages = json.loads(r.read().decode()).get("query", {}).get("pages", {})
                    for pg in pages.values():
                        if pg.get("fullurl"):
                            cand.append((pg.get("title", t), pg["fullurl"]))
            except Exception:
                pass
        seen = set()
        for t, u in cand:
            if u in seen:
                continue
            seen.add(u)
            if not self._relevant(u, t, query, surname):
                continue
            hreq = urllib.request.Request(u, method="HEAD", headers=ua)
            try:
                with urllib.request.urlopen(hreq, timeout=10) as r:
                    if r.status == 200:
                        return {"title": u.rsplit("/", 1)[-1].replace("_", " "),
                                "url": u}
            except Exception:
                continue
        return ""

    def _relevant(self, url, title, query, surname):
        try:
            eurl = ("https://en.wikipedia.org/w/api.php?action=query&prop=extracts"
                    "&exintro&explaintext&exchars=600&format=json&redirects=1&titles="
                    + urllib.parse.quote(title))
            ua = {"User-Agent": "mradio/0.3 (educational music enrichment) python-urllib"}
            req = urllib.request.Request(eurl, headers=ua)
            with urllib.request.urlopen(req, timeout=10) as r:
                res = json.loads(r.read().decode())
            pages = res.get("query", {}).get("pages", {})
            intro = ""
            for pg in pages.values():
                if "missing" not in pg:
                    intro = (pg.get("extract") or "")
                if pg.get("redirects"):
                    intro = intro or ""
            intro = intro.lower()
        except Exception:
            return False
        def toks(s):
            return set(re.findall(r"[a-zà-ÿ]+", s.lower()))
        qt = toks(query)
        tt = toks(title)
        if not qt or not tt:
            return False
        overlap = bool(qt & tt)
        surname_hit = (bool(surname) and surname.lower() in intro) or not surname
        return overlap and surname_hit

    def _pn(self, key):
        with self._lock:
            return self.last_key == key and key not in self.cache


def add(std, y, x, text, pair, attr=0):
    try:
        std.attron(curses.color_pair(pair) | attr)
        std.addstr(y, x, text)
        std.attroff(curses.color_pair(pair) | attr)
    except curses.error:
        pass


def draw_info(std, s, y, tw):
    if s["artist"]:
        add(std, y, 1, s["artist"][:tw], 4, curses.A_BOLD)
        y += 1
    add(std, y, 1, s["title"][:tw], 2, curses.A_BOLD)
    y += 1
    if s["performer"]:
        add(std, y, 1, s["performer"][:tw], 6)
        y += 1
    if s["work_label"]:
        add(std, y, 1, ("Work: " + s["work_label"])[:tw], 7)
        y += 1
    return y


def draw_help(std, s, y, tw, keys):
    line = keys + ("   o:open article" if s["wiki_url"] else "")
    add(std, y, 1, line[:tw], 6)


def draw_right(std, s, h, w):
    """Right-aligned footer: clickable UPDATE pill (h-2) + version (h-1).
    Returns the leftmost column taken so row text can avoid overlap."""
    left = w
    s["update_zone"] = None
    if h >= 2:
        url = s.get("update_url") or ""
        if url:
            label = " UPDATE "
            x0 = max(0, w - len(label) - 1)
            add(std, h - 2, x0, label, 3, curses.A_BOLD)
            s["update_zone"] = (h - 2, x0, x0 + len(label) - 1)
            left = min(left, x0)
    if h >= 1:
        ver = "v" + VERSION
        x0 = max(0, w - len(ver) - 1)
        add(std, h - 1, x0, ver, 1)
        left = min(left, x0)
    return left


def render(std, elapsed, s):
    std.erase()
    h, w = std.getmaxyx()
    y = 0
    tw = max(8, w - 2)
    host = (sys.argv[1] if len(sys.argv) > 1 else DEFAULT_URL).split("/")[2]
    st_show = (s.get("station") or host)[:max(8, w - 42)]

    badge = " ● RADIO "
    add(std, y, 0, badge, 3)
    x = len(badge)
    add(std, y, x, " ▸ ", 1)
    x += 3
    add(std, y, x, " " + st_show + " ", 2)
    x += len(st_show) + 2
    add(std, y, x, " ▸ ", 1)
    x += 3
    pill = " LIVE " if not s["pause"] else " PAUSED "
    add(std, y, x, pill, 8 if not s["pause"] else 9)
    x += len(pill)
    add(std, y, x, f" {s.get('theme') or 'dark'} (p)", 1)
    y += 2

    if s.get("details"):
        y = draw_info(std, s, y, tw)
        y += 1
        blurb = s.get("blurb") or ""
        z0 = y
        for line in (textwrap.wrap(blurb, width=tw) if blurb else []):
            if y >= h - 2:
                break
            add(std, y, 1, line, 2, curses.A_DIM)
            y += 1
        s["txt_zone"] = (z0, max(z0, y - 1)) if blurb else None
        rlim = draw_right(std, s, h, w)
        lw = max(8, min(tw, rlim - 2)) if rlim < w else tw
        if h >= 2 and ai_configured():
            upd = "   u:update" if s.get("update_url") else ""
            add(std, h - 2, 1,
                (f" now:{s.get('ai_provider') or ''}   "
                 f"z:collapse   q:quit   space:pause   r:reconnect{upd}")[:lw], 3)
        if h >= 1:
            draw_help(std, s, h - 1, lw,
                      " z:collapse   q:quit   space:pause   r:reconnect")
        std.refresh()
        return

    if h - y > 9:
        y = draw_info(std, s, y, tw)
        blurb = s.get("blurb") or ""
        if blurb:
            z0 = y
            lines = textwrap.wrap(blurb, width=tw) or [blurb]
            maxlines = max(1, (h - y) - 5)
            shown = lines[:maxlines]
            for line in shown:
                add(std, y, 1, line, 2, curses.A_DIM)
                y += 1
            if len(lines) > maxlines and shown:
                add(std, y - 1, 1, (shown[-1].rstrip() + " …")[:tw], 2, curses.A_DIM)
            s["txt_zone"] = (z0, y - 1)
        else:
            s["txt_zone"] = None
            pn = s.get("pn", "")
            if pn:
                add(std, y, 1, pn, 7)
                y += 1
        y += 1

    if h - y > 5:
        kbps = f"{s['kbps']//1000} kbps" if isinstance(s["kbps"], (int, float)) else "—"
        khz = f"{s['khz']/1000:.1f} kHz" if isinstance(s["khz"], (int, float)) else "—"
        codec = s["codec"] or "—"
        cache = f"{s['cache']:.1f}s" if isinstance(s["cache"], (int, float)) else "—"
        add(std, y, 1, (f" {kbps} · {khz} · {codec} · cache {cache} · "
                        f"stream {int(elapsed//60):02d}:{int(elapsed%60):02d}")[:tw], 7)
        y += 1

    if h - y > 4:
        vol = s["vol"] if isinstance(s["vol"], (int, float)) else 0
        vw = max(10, w - 14)
        add(std, y, 1, " vol " + ("MUTED " if s["mute"] else ""), 1)
        add(std, y + 1, 1, " " + meter(vw, vol, 100), 4)
        add(std, y + 1, 1 + vw + 2, f" {int(vol)}%", 2)
        y += 3

    rlim = draw_right(std, s, h, w)
    lw = max(8, min(tw, rlim - 2)) if rlim < w else tw

    if h >= 2 and ai_configured():
        prov = s.get("ai_provider") or ""
        upd = "   u:update" if s.get("update_url") else ""
        add(std, h - 2, 1,
            (f" AI: 1=opencode  2=ollama  3=api   now:{prov}   "
             f"press to re-request{upd}")[:lw], 3)

    if h >= 1:
        draw_help(std, s, h - 1, lw,
                  " q:quit   space:pause   + / -:volume   m:mute   r:reconnect   z:expand")

    std.refresh()


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-v", "--version"):
        print(f"mradio {VERSION}")
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    seed_settings()
    if len(sys.argv) > 1 and sys.argv[1] == "--settings":
        rows = [("ollama_url", OLLAMA), ("ollama_model", OLLAMA_MODEL),
                ("ollama_timeout", OLLAMA_TIMEOUT), ("ollama_gpu", OLLAMA_GPU),
                ("api_base", API_BASE), ("api_model", API_MODEL),
                ("api_timeout", API_TIMEOUT),
                ("opencode", OC), ("opencode_timeout", OC_TIMEOUT),
                ("provider", load_cfg().get("provider", "")),
                ("theme", load_cfg().get("theme", "dark")),
                ("mouse", load_cfg().get("mouse", 0))]
        for k, v in rows:
            print(f"{k} = {v}")
        key = API_KEY
        print("api_key = " + (key[:4] + "…" + key[-4:] if len(key) > 8
                              else ("…" if key else "")))
        print(f"settings file: {SETTINGS_FILE}")
        return
    url = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_URL
    ovr_name = sys.argv[2] if len(sys.argv) > 2 else None
    try:
        os.unlink(SOCK)
    except OSError:
        pass
    stdscr = curses.initscr()
    curses.noecho()
    curses.cbreak()
    stdscr.keypad(True)
    stdscr.timeout(150)
    stdscr.refresh()
    curses.start_color()
    curses.use_default_colors()
    init_colors(load_cfg().get("theme", "dark"))
    curses.curs_set(0)
    mouse_on = bool(load_cfg().get("mouse"))
    if mouse_on:
        try:
            curses.mousemask(curses.BUTTON1_PRESSED)
        except Exception:
            pass

    exit_code = 0
    proc = None
    enrich = None
    try:
        proc = launch_mpv(url)
        mpc = Mpc(SOCK)
        saved_vol = load_cfg().get("volume")
        apply_volume(mpc, saved_vol)
        state = make_state()
        state["station"] = ovr_name or url.split("/")[2]
        state["station_resolved"] = bool(ovr_name)
        ab = load_cfg().get("theme", "dark")
        state["theme"] = ab if ab in ("dark", "light") else "dark"
        enrich = Enricher()
        enrich.start()
        threading.Thread(target=check_update, daemon=True).start()
        state["ai_provider"] = enrich.active_provider()
        started = time.time()
        while True:
            t = time.time()
            if _latest["version"] and \
                    ver_key(_latest["version"]) > ver_key(VERSION):
                state["update_url"] = UPDATE_URL
            else:
                state["update_url"] = ""
            if proc.poll() is not None:
                proc = launch_mpv(url)
                mpc = Mpc(SOCK)
                apply_volume(mpc, saved_vol)
            if not state["station_resolved"]:
                icy = mpc.get("metadata/by-key/icy-name")
                if icy:
                    state["station"] = str(icy).strip()
                    state["station_resolved"] = True
                    log(f"station = {state['station']}")
            raw = mpc.get("metadata/by-key/icy-title") or ""
            if raw != state["raw_title"]:
                state["raw_title"] = raw
                if raw:
                    a, ti, p = split_title(raw)
                    state.update(artist=a, title=ti, performer=p)
                    state["details"] = False
                    enrich.submit(raw, a, ti, p)
                else:
                    state["title"] = "connecting…"
            item = enrich.blurb(state["raw_title"])
            if isinstance(item, dict):
                state["blurb"] = item.get("trivia") or ""
                state["work_label"] = item.get("work") or ""
                wk = item.get("wiki")
                if isinstance(wk, dict):
                    state["wiki_url"] = wk.get("url") or ""
                    state["wiki_title"] = wk.get("title") or ""
                else:
                    state["wiki_url"] = ""
                    state["wiki_title"] = ""
            else:
                state["blurb"] = ""
                state["work_label"] = ""
                state["wiki_url"] = ""
                state["wiki_title"] = ""
            if enrich.pending(state["raw_title"]):
                es = enrich.elapsed(state["raw_title"])
                prov = state.get("ai_provider") or ""
                state["pn"] = "▚▞"[(int(t * 2) % 2)] + \
                    (f" {prov} {es}s" if es > 0 else f" {prov}…")
            else:
                state["pn"] = ""
            state["kbps"] = mpc.get("audio-params/bitrate") or state["kbps"]
            state["khz"] = mpc.get("audio-params/samplerate") or state["khz"]
            state["codec"] = mpc.get("audio-codec-name") or state["codec"]
            state["cache"] = mpc.get("cache-duration")
            vol = mpc.get("volume")
            if isinstance(vol, (int, float)):
                state["vol"] = vol
            state["mute"] = bool(mpc.get("mute"))
            state["pause"] = bool(mpc.get("pause"))
            render(stdscr, t - started, state)
            ch = stdscr.getch()
            if ch == curses.KEY_RESIZE:
                continue
            if ch in (ord("q"), 27):
                break
            elif ch == ord(" "):
                mpc.cmd("cycle", "pause")
            elif ch in (ord("+"), ord("="), curses.KEY_RIGHT):
                mpc.cmd("add", "volume", 5)
                v = mpc.get("volume")
                if isinstance(v, (int, float)):
                    persist_cfg(volume=int(v))
            elif ch in (ord("-"), curses.KEY_LEFT):
                mpc.cmd("add", "volume", -5)
                v = mpc.get("volume")
                if isinstance(v, (int, float)):
                    persist_cfg(volume=int(v))
            elif ch == ord("m"):
                mpc.cmd("cycle", "mute")
            elif ch in (ord("o"), ord("O")):
                if state["wiki_url"]:
                    subprocess.Popen(["open", state["wiki_url"]])
            elif ch in (ord("u"), ord("U")):
                if state.get("update_url"):
                    subprocess.Popen(["open", state["update_url"]])
            elif ch in (ord("r"), ord("R")):
                proc.terminate()
                time.sleep(0.2)
                proc = launch_mpv(url)
                mpc = Mpc(SOCK)
                apply_volume(mpc, saved_vol)
            elif ch in (ord("1"), ord("2"), ord("3")):
                names = {ord("1"): "opencode", ord("2"): "ollama", ord("3"): "openai"}
                name = names[ch]
                if enrich.switch_provider(name):
                    state["ai_provider"] = name
                    rk = state["raw_title"]
                    if rk:
                        enrich.invalidate(rk, state["artist"],
                                          state["title"], state["performer"])
            elif ch == curses.KEY_MOUSE:
                try:
                    _, mx, my, _, bstate = curses.getmouse()
                    _, w = stdscr.getmaxyx()
                    if bstate & curses.BUTTON1_PRESSED:
                        uz = state.get("update_zone")
                        if uz and state.get("update_url"):
                            zy, zx0, zx1 = uz
                            if my == zy and zx0 <= mx <= zx1:
                                subprocess.Popen(["open", state["update_url"]])
                    zone = state.get("txt_zone")
                    if bstate & curses.BUTTON1_PRESSED and zone:
                        z0, z1 = zone
                        if z0 <= my <= z1 and 1 <= mx <= max(1, w - 2):
                            state["details"] = not state["details"]
                except Exception:
                    pass
            elif ch in (ord("z"), ord("Z")):
                state["details"] = not state["details"]
            elif ch in (ord("p"), ord("P")):
                state["theme"] = "light" if state["theme"] != "light" else "dark"
                init_colors(state["theme"])
                persist_cfg(theme=state["theme"])
                log(f"theme switched to {state['theme']}")
    except KeyboardInterrupt:
        exit_code = 130
    except Exception:
        exit_code = 1
    finally:
        if proc is not None:
            try:
                proc.terminate()
            except Exception:
                pass
            try:
                proc.wait(timeout=2)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        if enrich is not None:
            try:
                enrich.shutdown()
            except Exception:
                pass
        try:
            os.unlink(SOCK)
        except OSError:
            pass
    try:
        curses.endwin()
    except Exception:
        pass
    os._exit(exit_code)


if __name__ == "__main__":
    main()