def latest_release_version(body):
    tags = re.findall(r"releases/tag/v?([0-9]+(?:\.[0-9]+){1,3})", body or "")
    return tags[0] if tags else None


def check_update():
    """Fetch the newest release tag from the GitHub atom feed (once, in the
    background). Never downloads or runs code — it only reports."""
    try:
        req = urllib.request.Request(
            f"https://github.com/{UPDATE_REPO}/releases.atom",
            headers={"User-Agent": "mradio/" + VERSION})
        with urllib.request.urlopen(req, timeout=6) as r:
            body = r.read().decode("utf-8", "replace")
        _latest["version"] = latest_release_version(body)
        log(f"update check: latest={_latest['version']} current={VERSION}")
    except Exception as e:
        log(f"update check FAIL: {e}", "WARN")


def extract_json_item(raw):
    item = {"work": "", "trivia": "", "wiki": "", "movement": 0}
    r = re.sub(r"^```(?:json)?\s*", "", raw.strip())
    r = re.sub(r"\s*```$", "", r)
    a, b = r.find("{"), r.rfind("}")
    if a != -1 and b > a:
        try:
            p = json.loads(r[a:b + 1])
            if isinstance(p, dict):
                return {
                    "work": str(p.get("work") or "").strip(),
                    "trivia": str(p.get("trivia") or "").strip(),
                    "wiki": str(p.get("wiki") or "").strip(),
                    "movement": 1 if p.get("movement") == 1 else 0,
                }
        except Exception:
            pass

    def g(key):
        m = re.search(rf'"{re.escape(key)}"\s*:\s*"((?:[^"\\]|\\.)*)"', r)
        if m:
            v = m.group(1).replace('\\"', '"').replace("\\n", " ")
            v = v.replace("\\u2019", "’").replace("\\u2018", "‘")
            return v
        return None

    trivia, wiki, work = g("trivia"), g("wiki"), g("work")
    mm = re.search(r'"movement"\s*:\s*([01])', r)
    got = [v for v in (trivia, wiki, work) if v is not None] or (mm is not None)
    if got:
        item["trivia"] = trivia or ""
        item["wiki"] = wiki or ""
        item["work"] = work or ""
        item["movement"] = 1 if (mm and mm.group(1) == "1") else 0
        return item
    if re.search(r"\b(movement|tagged name|json|schema)\b", r, re.I):
        return item
    item["trivia"] = elide(" ".join(r.split()))
    return item


def split_title(raw):
    raw = repair_mojibake(raw)
    raw = re.sub(r"\s*\{[^}]*\}", "", raw).strip()
    artist, sep, title = raw.partition(" - ")
    if not sep:
        artist, title = "", raw
    performer = ""
    i = title.find("(")
    if i != -1:
        candidate = title[i:].strip()
        if candidate.endswith(")") and len(candidate) > 2:
            performer = candidate
            title = title[:i].strip()
    return artist, title.strip(), performer


def meter(width, value, nmax):
    if nmax <= 0:
        return " " * width
    filled = int(round(width * min(value, nmax) / nmax))
    return "█" * filled + "░" * (width - filled)


