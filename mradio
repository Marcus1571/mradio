    tw = max(8, w - 2)
    host = (sys.argv[1] if len(sys.argv) > 1 else DEFAULT_URL).split("/")[2]
    st_show = (s.get("station") or host)[:max(8, w - 42)]

    badge = " ● RADIO "
    add(std, y, 0, badge, 3)
    x = len(badge)
    add(std, y, x, " ▸ ", 1)
    x += 3
    add(std, y, x, " " + st_show + " ", 2)
    x += len(st_show) + 2
    add(std, y, x, " ▸ ", 1)
    x += 3
    pill = " LIVE " if not s["pause"] else " PAUSED "
    add(std, y, x, pill, 8 if not s["pause"] else 9)
    x += len(pill)
    add(std, y, x, f" {s.get('theme') or 'dark'} (p)", 1)
    y += 2

    if s.get("details"):
        y = draw_info(std, s, y, tw)
        y += 1
        blurb = s.get("blurb") or ""
        z0 = y
        for line in (textwrap.wrap(blurb, width=tw) if blurb else []):
            if y >= h - 3:
                break
            add(std, y, 1, line, 5, curses.A_DIM)
            y += 1
        s["txt_zone"] = (z0, max(z0, y - 1)) if blurb else None
        rlim = draw_right(std, s, h, w)
        lw = max(8, min(tw, rlim - 2)) if rlim < w else tw
        if h >= 3 and ai_configured():
            line = (f" AI: 1=opencode  2=ollama  3=api   "
                    f"now:{s.get('ai_provider') or ''}   press to re-request   z:collapse")
            if s.get("update_msg") and time.time() - (s.get("update_msg_t") or 0) < 6:
                line = s["update_msg"]
            add(std, h - 3, 1, line[:lw], 3)
        if h >= 2:
            if s.get("update_msg") and time.time() - (s.get("update_msg_t") or 0) < 6:
                mid = f" {s['update_msg']}"
            else:
                mid = (f" f:favorites   s:all   k:kb   v:check" +
                       ("   u:page   U:apply" if s.get("update_url") else ""))
            add(std, h - 2, 1, mid[:lw], 5, curses.A_DIM)
        if h >= 1:
            draw_help(std, s, h - 1, lw,
                      " q:quit   space:pause   + / -:volume   m:mute   r:reconnect")
        std.refresh()
        return

    if h - y > 9:
        y = draw_info(std, s, y, tw)
        blurb = s.get("blurb") or ""
        if blurb:
            z0 = y
            lines = textwrap.wrap(blurb, width=tw) or [blurb]
            maxlines = max(1, (h - y) - 5)
            shown = lines[:maxlines]
            for line in shown:
                add(std, y, 1, line, 5, curses.A_DIM)
                y += 1
            if len(lines) > maxlines and shown:
                add(std, y - 1, 1, (shown[-1].rstrip() + " …")[:tw], 5, curses.A_DIM)
            s["txt_zone"] = (z0, y - 1)
        else:
            s["txt_zone"] = None
            pn = s.get("pn", "")
            if pn:
                add(std, y, 1, pn, 7)
                y += 1
        y += 1

    if h - y > 5:
        kbps = f"{s['kbps']//1000} kbps" if isinstance(s["kbps"], (int, float)) else "—"
        khz = f"{s['khz']/1000:.1f} kHz" if isinstance(s["khz"], (int, float)) else "—"
        codec = s["codec"] or "—"
        cache = f"{s['cache']:.1f}s" if isinstance(s["cache"], (int, float)) else "—"
        add(std, y, 1, (f" {kbps} · {khz} · {codec} · cache {cache} · "
                        f"stream {int(elapsed//60):02d}:{int(elapsed%60):02d}")[:tw], 7)
        y += 1

    if h - y > 4:
        vol = s["vol"] if isinstance(s["vol"], (int, float)) else 0
        vw = max(10, w - 14)
        add(std, y, 1, " vol " + ("MUTED " if s["mute"] else ""), 1)
        add(std, y + 1, 1, " " + meter(vw, vol, 100), 4)
        add(std, y + 1, 1 + vw + 2, f" {int(vol)}%", 2)
        y += 3

    rlim = draw_right(std, s, h, w)
    lw = max(8, min(tw, rlim - 2)) if rlim < w else tw

    if h >= 2:
        if s.get("update_msg") and time.time() - (s.get("update_msg_t") or 0) < 6:
            mid = f" {s['update_msg']}"
        else:
            mid = (f" f:favorites   s:all   k:kb   v:check" +
                   ("" if s.get("update_pending")
                    else ("   u:page   U:apply" if s.get("update_url") else "")))
        add(std, h - 2, 1, mid[:lw], 5, curses.A_DIM)

    if h >= 3 and ai_configured():
        prov = s.get("ai_provider") or ""
        line = (f" AI: 1=opencode  2=ollama  3=api   now:{prov}   "
                f"press to re-request   z:expand")
        if s.get("update_msg") and time.time() - (s.get("update_msg_t") or 0) < 6:
            line = s["update_msg"]
        add(std, h - 3, 1, line[:lw], 3)

    if h >= 1:
        draw_help(std, s, h - 1, lw,
                  " q:quit   space:pause   + / -:volume   m:mute   r:reconnect")

    std.refresh()


def render_menu(std, s, mode, cur):
    """Draw a station menu: `f` = your favorites (1-9), `s` = all stations (S01...)."""
    std.erase()
    h, w = std.getmaxyx()
    if mode == "fav":
        sts = s.get("fav_stations") or []
        label = " my stations "
        heading = "Your stations"
    else:
        sts = s.get("all_stations") or []
        label = " all stations "
        heading = "All stations"
    badge = " ● RADIO "
    add(std, 0, 0, badge, 3)
    x = len(badge)
    add(std, 0, x, " ▸ ", 1)
    x += 3
    add(std, 0, x, label, 2, curses.A_BOLD)
    x += len(label)
    add(std, 0, x, " ▸ ", 1)
    x += 3
    add(std, 0, x, " SELECT ", 8)
    x += 8
    add(std, 0, x, f" {s.get('theme') or 'dark'} (p)", 1)

    y = 2
    add(std, y, 1, heading, 1, curses.A_BOLD)
    y += 1
    for i, ent in enumerate(sts):
        if mode == "fav" and i >= 10:
            break
        if y >= h - 2:
            break
        if i == cur:
            add(std, y, 1, "▶", 2, curses.A_BOLD)
        tag = f"S{i + 1:02d}" if mode == "all" else (f"{i + 1}" if i < 9 else "0")
        add(std, y, 4, tag, 1)
        name = (ent.get("name") or "?").strip()
        nlim = max(1, w - 26)
        add(std, y, 8, name[:nlim], 6)
        host = (ent.get("url") or "").split("/")[2]
        sx = 8 + min(len(name), nlim) + 2
        if sx < w - 4:
            add(std, y, sx, host[:w - sx - 1], 5, curses.A_DIM)
        y += 1

    draw_right(std, s, h, w)
    rlim = min(w, (s.get("update_zone") or (0, w))[1]) if s.get("update_zone") else w
    lw = max(8, min(w - 2, rlim - 2)) if rlim < w else w - 2
    if h >= 2:
        if s.get("update_msg") and time.time() - (s.get("update_msg_t") or 0) < 6:
            line = s["update_msg"]
        elif mode == "fav":
            line = f" pick a number — {len(sts)} favorite(s)"
        else:
            line = " ↑/↓ move · Enter pick · a add to favorites"
        add(std, h - 2, 1, line[:lw], 3)
    if h >= 1:
        if mode == "fav":
            help_txt = "1-9,0:pick  ↑/↓:move  q/Esc:back  s:all  v:check"
        else:
            help_txt = "Enter:pick  f:fav  ↑/↓:move  q/Esc:back  v:check"
        if s.get("update_url") and not s.get("update_pending"):
            help_txt += "  u:page  U:apply"
        add(std, h - 1, 1, help_txt[:lw], 6)
    std.refresh()


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-v", "--version"):
        print(f"mradio {VERSION}")
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    seed_settings()
    if len(sys.argv) > 1 and sys.argv[1] == "--settings":
        rows = [("ollama_url", OLLAMA), ("ollama_model", OLLAMA_MODEL),
                ("ollama_timeout", OLLAMA_TIMEOUT), ("ollama_gpu", OLLAMA_GPU),
                ("api_base", API_BASE), ("api_model", API_MODEL),
                ("api_timeout", API_TIMEOUT),
                ("opencode", OC), ("opencode_timeout", OC_TIMEOUT),
                ("provider", load_cfg().get("provider", "")),
                ("theme", load_cfg().get("theme", "dark")),
                ("mouse", load_cfg().get("mouse", 0)),
                ("stations", f"{len(load_favorites())} favorites "
                             f"('{STATIONS_FILE}', key 'favorites')")]
        for k, v in rows:
            print(f"{k} = {v}")
        key = API_KEY
        print("api_key = " + (key[:4] + "…" + key[-4:] if len(key) > 8
                              else ("…" if key else "")))
        print(f"settings file: {SETTINGS_FILE}")
        return
    url0 = sys.argv[1] if len(sys.argv) > 1 else None
    ovr_name = sys.argv[2] if len(sys.argv) > 2 else None
    try:
        os.unlink(SOCK)
    except OSError:
        pass
    stdscr = curses.initscr()
    curses.noecho()
    curses.cbreak()
    stdscr.keypad(True)
    stdscr.timeout(150)
    stdscr.refresh()
    curses.start_color()
    curses.use_default_colors()
    init_colors(load_cfg().get("theme", "dark"))
    curses.curs_set(0)
    mouse_on = bool(load_cfg().get("mouse"))
    if mouse_on:
        try:
            curses.mousemask(curses.BUTTON1_PRESSED)
        except Exception:
            pass

    exit_code = 0
    proc = None
    enrich = None
    try:
        mpc = Mpc(SOCK)
        saved_vol = load_cfg().get("volume")
        state = make_state()
        stations = load_favorites()
        state["fav_stations"] = stations
        state["all_stations"] = list(DEFAULT_STATIONS)
        ab = load_cfg().get("theme", "dark")
        state["theme"] = ab if ab in SCHEMES else "dark"
        enrich = Enricher()
        enrich.start()
        threading.Thread(target=update_watcher, daemon=True).start()
        state["ai_provider"] = enrich.active_provider()
        started = time.time()
        proc = None
        url = url0
        cur_st = 0
        menu = "fav" if url is None else None

        def switch_stream(ent):
            nonlocal url, proc, mpc
            nurl = (ent.get("url") or "").strip()
            if not nurl:
                return
            url = nurl
            state["station"] = (ent.get("name") or url.split("/")[2]).strip()
            state["raw_title"] = ""
            state["title"] = "connecting…"
            state["artist"] = state["performer"] = state["blurb"] = ""
            state["work_label"] = state["wiki_url"] = state["pn"] = ""
            state["kbps"] = state["khz"] = state["codec"] = state["cache"] = None
            state["details"] = False
            if proc is not None:
                try:
                    proc.terminate()
                except Exception:
                    pass
                time.sleep(0.2)
            proc = launch_mpv(url)
            mpc = Mpc(SOCK)
            apply_volume(mpc, saved_vol)

        if menu is None:
            state["station"] = ovr_name or url.split("/")[2]
            state["station_resolved"] = bool(ovr_name)
            proc = launch_mpv(url)
            apply_volume(mpc, saved_vol)

        def show_favorites():
            nonlocal cur_st
            favs = load_favorites()
            state["fav_stations"] = favs
            cur_st = min(cur_st, max(0, len(favs) - 1))

        while True:
            t = time.time()
            if _latest["version"] and \
                    ver_key(_latest["version"]) > ver_key(VERSION):
                state["update_url"] = UPDATE_URL
            else:
                state["update_url"] = ""
            if menu is not None:
                lst = (state["fav_stations"] if menu == "fav"
                       else state["all_stations"])
                render_menu(stdscr, state, menu, min(cur_st, max(0, len(lst) - 1)))
                ch = stdscr.getch()
                if ch == 27:
                    ch = _follow_esc(stdscr)
                if ch == curses.KEY_RESIZE:
                    continue
                if ch in (ord("q"), 27):
                    if proc is None:
                        break
                    menu = None
                elif ch == ord("f"):
                    if menu != "fav":
                        show_favorites()
                    menu = "fav"
                elif ch == ord("s"):
                    menu = "all"
                elif ch == ord("a") and menu == "all":
                    ent = state["all_stations"][
                        min(cur_st, len(state["all_stations"]) - 1)]
                    if len(state["fav_stations"]) >= 10:
                        state["update_msg"] = "favorites full - 10 max (a ignored)"
                    elif any(x.get("url") == ent["url"]
                             for x in state["fav_stations"]):
                        state["update_msg"] = \
                            f"already in favorites: {ent['name']}"
                    elif save_favorites(list(state["fav_stations"]) + [dict(ent)]):
                        state["fav_stations"] = \
                            list(state["fav_stations"]) + [dict(ent)]
                        state["update_msg"] = \
                            f"a added to favorites: {ent['name']}"
                    else:
                        state["update_msg"] = "could not save favorites"
                    state["update_msg_t"] = time.time()
                elif ch == ord("p"):
                    state["theme"] = next_theme(state["theme"])
                    init_colors(state["theme"])
                    persist_cfg(theme=state["theme"])
                    log(f"theme switched to {state['theme']}")
                elif ch == ord("u"):
                    if state.get("update_url"):
                        subprocess.Popen(["open", state["update_url"]])
                elif ch == ord("U"):
                    if state.get("update_url"):
                        ok, msg = apply_update()
                        state["update_msg"] = msg
                        state["update_msg_t"] = time.time()
                        if ok:
                            state["update_pending"] = True
                        else:
                            subprocess.Popen(["open", state["update_url"]])
                elif ch == ord("v"):
                    force_check(state)
                elif ch in (curses.KEY_DOWN, ord("j")) and cur_st < len(lst) - 1:
                    cur_st += 1
                elif ch in (curses.KEY_UP, ord("k")) and cur_st > 0:
                    cur_st -= 1
                elif ch in (10, 13, curses.KEY_ENTER):
                    if cur_st < len(lst):
                        switch_stream(lst[cur_st])
                        menu = None
                elif menu == "fav":
                    idx = fav_index(ch)
                    if idx is not None and idx < len(lst):
                        cur_st = idx
                        switch_stream(lst[idx])
                        menu = None
                continue
            if proc.poll() is not None:
                proc = launch_mpv(url)
                mpc = Mpc(SOCK)
                apply_volume(mpc, saved_vol)
            if not state["station_resolved"]:
                icy = mpc.get("metadata/by-key/icy-name")
                if icy:
                    state["station"] = str(icy).strip()
                    state["station_resolved"] = True
                    log(f"station = {state['station']}")
            raw = mpc.get("metadata/by-key/icy-title") or ""
            if raw != state["raw_title"]:
                state["raw_title"] = raw
                if raw:
                    a, ti, p = split_title(raw)
                    state.update(artist=a, title=ti, performer=p)
                    state["details"] = False
                    enrich.submit(raw, a, ti, p)
                else:
                    state["title"] = "connecting…"
            item = enrich.blurb(state["raw_title"])
            if isinstance(item, dict):
                state["blurb"] = item.get("trivia") or ""
                state["work_label"] = item.get("work") or ""
                wk = item.get("wiki")
                if isinstance(wk, dict):
                    state["wiki_url"] = wk.get("url") or ""
                    state["wiki_title"] = wk.get("title") or ""
                else:
                    state["wiki_url"] = ""
                    state["wiki_title"] = ""
            else:
                state["blurb"] = ""
                state["work_label"] = ""
                state["wiki_url"] = ""
                state["wiki_title"] = ""
            if enrich.pending(state["raw_title"]):
                es = enrich.elapsed(state["raw_title"])
                prov = state.get("ai_provider") or ""
                state["pn"] = "▚▞"[(int(t * 2) % 2)] + \
                    (f" {prov} {es}s" if es > 0 else f" {prov}…")
            else:
                state["pn"] = ""
            state["kbps"] = mpc.get("audio-params/bitrate") or state["kbps"]
            state["khz"] = mpc.get("audio-params/samplerate") or state["khz"]
            state["codec"] = mpc.get("audio-codec-name") or state["codec"]
            state["cache"] = mpc.get("cache-duration")
            vol = mpc.get("volume")
            if isinstance(vol, (int, float)):
                state["vol"] = vol
            state["mute"] = bool(mpc.get("mute"))
            state["pause"] = bool(mpc.get("pause"))
            render(stdscr, t - started, state)
            ch = stdscr.getch()
            if ch == curses.KEY_RESIZE:
                continue
            if ch in (ord("q"), 27):
                break
            elif ch == ord(" "):
                mpc.cmd("cycle", "pause")
            elif ch in (ord("+"), ord("="), curses.KEY_RIGHT):
                mpc.cmd("add", "volume", 5)
                v = mpc.get("volume")
                if isinstance(v, (int, float)):
                    persist_cfg(volume=int(v))
            elif ch in (ord("-"), curses.KEY_LEFT):
                mpc.cmd("add", "volume", -5)
                v = mpc.get("volume")
                if isinstance(v, (int, float)):
                    persist_cfg(volume=int(v))
            elif ch == ord("m"):
                mpc.cmd("cycle", "mute")
                m = bool(mpc.get("mute"))
                persist_cfg(mute=m)
            elif ch in (ord("o"), ord("O")):
                if state["wiki_url"]:
                    subprocess.Popen(["open", state["wiki_url"]])
            elif ch == ord("u"):
                if state.get("update_url"):
                    subprocess.Popen(["open", state["update_url"]])
            elif ch == ord("U"):
                if state.get("update_url"):
                    ok, msg = apply_update()
                    state["update_msg"] = msg
                    state["update_msg_t"] = time.time()
                    if ok:
                        state["update_pending"] = True
                    else:
                        subprocess.Popen(["open", state["update_url"]])
            elif ch == ord("v"):
                force_check(state)
            elif ch in (ord("k"), ord("K")):
                subprocess.Popen(["open", KB_URL])
            elif ch == ord("s"):
                menu = "all"
            elif ch == ord("f"):
                show_favorites()
                menu = "fav"
            elif ch in (ord("r"), ord("R")):
                proc.terminate()
                time.sleep(0.2)
                proc = launch_mpv(url)
                mpc = Mpc(SOCK)
                apply_volume(mpc, saved_vol)
            elif ch in (ord("1"), ord("2"), ord("3")):
                names = {ord("1"): "opencode", ord("2"): "ollama", ord("3"): "openai"}
                name = names[ch]
                if enrich.switch_provider(name):
                    state["ai_provider"] = name
                    rk = state["raw_title"]
                    if rk:
                        enrich.invalidate(rk, state["artist"],
                                          state["title"], state["performer"])
            elif ch == curses.KEY_MOUSE:
                try:
                    _, mx, my, _, bstate = curses.getmouse()
                    _, w = stdscr.getmaxyx()
                    if bstate & curses.BUTTON1_PRESSED:
                        uz = state.get("update_zone")
                        if uz and state.get("update_url"):
                            zy, zx0, zx1 = uz
                            if my == zy and zx0 <= mx <= zx1:
                                subprocess.Popen(["open", state["update_url"]])
                    zone = state.get("txt_zone")
                    if bstate & curses.BUTTON1_PRESSED and zone:
                        z0, z1 = zone
                        if z0 <= my <= z1 and 1 <= mx <= max(1, w - 2):
                            state["details"] = not state["details"]
                except Exception:
                    pass
            elif ch in (ord("z"), ord("Z")):
                state["details"] = not state["details"]
            elif ch in (ord("p"), ord("P")):
                state["theme"] = next_theme(state["theme"])
                init_colors(state["theme"])
                persist_cfg(theme=state["theme"])
                log(f"theme switched to {state['theme']}")
    except KeyboardInterrupt:
        exit_code = 130
    except Exception:
        exit_code = 1
    finally:
        if proc is not None:
            try:
                proc.terminate()
            except Exception:
                pass
            try:
                proc.wait(timeout=2)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        if enrich is not None:
            try:
                enrich.shutdown()
            except Exception:
                pass
        try:
            os.unlink(SOCK)
        except OSError:
            pass
    try:
        # Drain any pending terminal input so it can't leak into the shell
        # once curses hands the tty back (random ghost digits at the prompt).
        stdscr.nodelay(True)
        for _ in range(64):
            if stdscr.getch() == -1:
                break
    except Exception:
        pass
    try:
        curses.endwin()
    except Exception:
        pass
    os._exit(exit_code)


if __name__ == "__main__":
    main()