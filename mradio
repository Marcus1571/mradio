def draw_right(std, s, h, w):
    """Right-aligned footer: update pill (h-2) + version (h-1).
    The pill reads `UPDATE` while a newer release is available and
    `RESTART TO UPDATE` once `U` has swapped the new file in (the running
    copy only takes effect after a restart). Returns the leftmost column
    taken so row text can avoid overlap."""
    left = w
    s["update_zone"] = None
    if h >= 2:
        if s.get("update_url"):
            label = " RESTART TO UPDATE " if s.get("update_pending") else \
                " UPDATE "
            x0 = max(0, w - len(label) - 1)
            add(std, h - 2, x0, label, 10, curses.A_BOLD)
            s["update_zone"] = (h - 2, x0, x0 + len(label) - 1)
            left = min(left, x0)
    if h >= 1:
        ver = "v" + VERSION
        x0 = max(0, w - len(ver) - 1)
        add(std, h - 1, x0, ver, 1)
        left = min(left, x0)
    return left


def render(std, elapsed, s):
    std.erase()
    h, w = std.getmaxyx()
