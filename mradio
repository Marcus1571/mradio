def oc_port():
    if not OC:
        return 0
    if OC.strip() in ("1", "on", "yes", "true"):
        return 4096
    try:
        return int(OC)
    except ValueError:
        return 4096


def provider_enabled(name):
    probe = {"opencode": bool(oc_port()), "ollama": bool(OLLAMA),
             "openai": bool(API_KEY)}
    return probe.get(name, False)


