def fav_index(ch):
    """Map a digit key ('1'-'9' or '0') to a favorites index; 0 = #10."""
    if ord("1") <= ch <= ord("9"):
        return ch - ord("1")
    if ch == ord("0"):
        return 9
    return None


def _follow_esc(std):
    """Resolve an `Esc` that may start an application-keypad sequence so the
    numeric pad behaves like the main number row (digits '1'-'9','0', pad
    Enter). A bare `Esc` (nothing follows) stays `27`; unknown sequences are
    ignored (-1)."""
    std.nodelay(True)
    try:
        time.sleep(0.03)
        nxt = std.getch()
        if nxt == -1:
            return 27
        if nxt in (ord("O"), ord("[")):
            d = std.getch()
            if d != -1 and nxt == ord("O") and ord("0") <= d <= ord("9"):
                return d
            if d == ord("M") and nxt == ord("O"):
                return 13
            return -1
        return -1
    finally:
        std.nodelay(False)


def load_favorites():
    """Your numbered 'favorites' list (the 1-9 + 0 quick-pick rows, max 10).

    Read from stations.json ("favorites" key). First run on a new machine
    auto-seeds that file with the curated DEFAULT_STATIONS so the menu is
    useful immediately; afterwards the file is entirely the user's and
    releases never touch it again. A legacy config.json "stations" list is
    honored (and migrated into stations.json) when no stations.json exists."""
    def norm(lst):
        out = []
        for x in lst:
            u = str(x.get("url") or "").strip()
            if not u:
                continue
            out.append({"name": str(x.get("name") or u.split("/")[2]).strip(),
                        "url": u})
        return out
    lst = None
    try:
        with open(STATIONS_FILE) as fh:
            d = json.load(fh)
        if isinstance(d, dict):
            lst = d.get("favorites")
    except FileNotFoundError:
        lst = None
    except Exception:
        log(f"favorites read FAIL (invalid {STATIONS_FILE})", "WARN")
        return list(DEFAULT_STATIONS)[:10]
    if isinstance(lst, list):
        return norm(lst)
    try:
        cfg_lst = load_cfg().get("stations")
        if isinstance(cfg_lst, list) and cfg_lst:
            out = norm(cfg_lst)[:10]
            if out:
                save_favorites(out)
                return out
    except Exception:
        pass
    out = list(DEFAULT_STATIONS)[:10]
    if not save_favorites(out):
        log("favorites seed FAIL (wrote nothing)", "WARN")
    return out


