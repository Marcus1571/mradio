def apply_volume(mpc, vol, muted=None):
    """Push the saved volume (and the saved muted state) into a fresh mpv.

    mpv starts every new process unmuted and with its default volume, so this
    must be called after every launch / reconnect / station switch — otherwise
    a mute is silently lost the moment mpv restarts."""
    if vol is None:
        return
    if muted is None:
        muted = bool(load_cfg().get("mute"))
    for _ in range(20):
        if mpc.cmd("set_property", "volume", float(vol)) is not None:
            break
        time.sleep(0.1)
    try:
        mpc.cmd("set_property", "mute", "yes" if muted else "no")
    except Exception:
        pass


class Enricher:
    def __init__(self):
        self.q = queue.Queue()
        self.cache = self._load_cache()
        self.offline_until = 0.0
        self.last_key = None
        self._oc_proc = None
        self.started = {}
        self.epoch = 0
        self.provider = self._load_provider()
        self._lock = threading.RLock()

    def _load_cache(self):
        try:
            with open(CACHE_FILE) as fh:
                data = json.load(fh)
            if not isinstance(data, dict):
                return {}
            # keep only the most recent 800 entries on load
            return {k: v for k, v in list(data.items())[-800:] if isinstance(v, dict)}
        except Exception:
            return {}

    def persist_cache(self):
        with self._lock:
            try:
                os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
                tmp = CACHE_FILE + ".tmp"
                with open(tmp, "w") as fh:
                    json.dump(self.cache, fh)
                os.replace(tmp, CACHE_FILE)
            except Exception as e:
                log(f"cache persist FAIL: {e}", "WARN")

    def _load_provider(self):
        p = load_cfg().get("provider", "")
        return p if p in PROVIDERS else ""

    def active_provider(self):
        with self._lock:
            prv = self.provider
        order = ([prv] if provider_enabled(prv) else []) \
            + [n for n in PROVIDERS if n != prv and provider_enabled(n)]
        return order[0] if order else ""

    def switch_provider(self, name):
        if name not in PROVIDERS or not provider_enabled(name):
            log(f"provider switch to {name} rejected (not configured)")
            return False
        with self._lock:
            self.provider = name
            self.offline_until = 0.0
        persist_cfg(provider=name)
        log(f"provider switched to {name}")
        return True

    def invalidate(self, key, artist, title, performer):
        with self._lock:
            self.epoch += 1
            self.cache.pop(key, None)
            self.started.pop(key, None)
        self.persist_cache()
        self.submit(key, artist, title, performer)

    def start(self):
        threading.Thread(target=self._worker, daemon=True).start()

    def blurb(self, key):
        with self._lock:
            return self.cache.get(key) if self.provider_matches(key) else None

    def provider_matches(self, key):
        with self._lock:
            item = self.cache.get(key)
            return (isinstance(item, dict) and item.get("provider") == self.provider
                    and not item.get("fail"))

    def pending(self, key):
        if not ai_configured():
            return False
        with self._lock:
            return self.last_key == key and not self.provider_matches(key)

    def submit(self, key, artist, title, performer):
        with self._lock:
            self.last_key = key
            if self.provider_matches(key):
                return
            self.started[key] = time.time()
        self.q.put((key, artist, title, performer))

    def elapsed(self, key):
        with self._lock:
            t = self.started.get(key)
        return int(time.time() - t) if t else 0

    def _worker(self):
        while True:
            key, artist, title, performer = self.q.get()
            with self._lock:
                epoch = self.epoch
            if not ai_configured():
                log("ai not configured, skipping enrichment")
                with self._lock:
                    self.cache[key] = {"work": "", "trivia": "", "wiki": "",
                                       "movement": 0, "provider": self.provider,
                                       "fail": True}
                    self.started.pop(key, None)
                continue
            if time.time() < self.offline_until:
                log(f"offline cooldown until {time.strftime('%H:%M:%S', time.localtime(self.offline_until))}, skipping")
                with self._lock:
                    self.cache[key] = {"work": "", "trivia": "", "wiki": "",
                                       "movement": 0, "provider": self.provider,
                                       "fail": True}
                    self.started.pop(key, None)
                continue
            t0 = time.time()
            log(f"enrich start: {artist!r} - {title!r}")
            item = self._ask(artist, title, performer)
            had_wiki = bool(item and item.get("wiki"))
            if item is None:
                with self._lock:
                    self.offline_until = time.time() + 120
                log("ALL providers failed -> offline 120s", "WARN")
                item = {"work": "", "trivia": "", "wiki": "", "movement": 0,
                        "fail": True}
            else:
                if item.get("wiki"):
                    surname = (artist.split("(")[0].split()[-1] if artist else "") or ""
                    wt0 = time.time()
                    item["wiki"] = self._resolve_wiki(item["wiki"], surname)
                    log(f"wiki resolve {item['wiki']!r} elapse={time.time()-wt0:.1f}s")
            with self._lock:
                self.started.pop(key, None)
                stale = epoch != self.epoch
            if stale:
                log("stale reply discarded (provider/selection changed)")
                continue
            with self._lock:
                item["provider"] = self.provider
                self.cache[key] = item
                # dict insertion order => pop(next(iter(...))) evicts the OLDEST
                # entry, never this just-written (newest) one.
                if len(self.cache) > 256:
                    self.cache.pop(next(iter(self.cache)))
            self.persist_cache()
            log(f"enrich done elapse={time.time()-t0:.1f}s "
                f"trivia={len(item.get('trivia') or '')}ch "
                f"work={bool(item.get('work'))} "
                f"wiki={had_wiki}->{bool(item.get('wiki'))}")

    def _ask(self, artist, title, performer):
        question = (
            f"Artist/Composer: {artist or 'unknown'} · "
            f"Tagged name: {title or 'unknown'} · "
            f"Performer (if present): {performer or 'none'}"
        )
        prompt = (
            "You enrich classical-radio metadata for a live classical radio stream.\n"
            + question + "\n"
            "Reply with ONLY a single raw JSON object, nothing else. No markdown, "
            "no code fences, no reasoning, no explanations, no text before or "
            "after. Use exactly this shape:\n"
            '{"movement": 0, "work": "", "wiki": "", "trivia": ""}\n'
            "Rules:\n"
            '- "movement": 1 ONLY if the tagged name is a movement, part, section '
            'or fragment of a larger complete work (e.g. "1. Allegro", "Adagio", '
            '"Finale", "Menuetto", "II."). A short standalone piece such as a '
            'mazurka, prelude, song, waltz or individual character piece IS the '
            'whole work: use 0 and leave "work" empty.\n'
            '- "work": the canonical name of the WHOLE work with opus/catalogue '
            'number, ONLY when "movement" is 1; otherwise "".\n'
            '- "wiki": the exact English Wikipedia article title of the whole work '
            'with its disambiguator, e.g. "Mazurkas, Op. 67 (Chopin)" or '
            '"Sonata da camera No. 3 (Corelli)"; if none exists return "".\n'
            '- "trivia": 6-9 short plain sentences that weave together BOTH '
            '(a) the composer — who they were, their era/place in music '
            'history, notable relations or legacy — and (b) the piece being '
            'played — date, catalogue number, structure/movements, dedication, '
            'premiere, notable performers or recordings, where one may have '
            'heard it. Flow naturally from one to the other (either order, no '
            'headings, no labels). Aim for 750-850 characters with a hard '
            'maximum of 850 — if your draft runs long, tighten it. Always end '
            'on a complete, natural final sentence; never trail off mid-thought.\n'
            "Output the JSON object and nothing else."
        )
        raw = self._llm(prompt)
        if raw is None:
            return None
        item = extract_json_item(raw)
        if not item["movement"]:
            item["work"] = ""
        item["trivia"] = elide((item["trivia"] or "").replace('"', ""))
        return item

    def _llm(self, prompt):
        order = ([self.provider] if provider_enabled(self.provider) else []) \
            + [n for n in PROVIDERS if n != self.provider and provider_enabled(n)]
        fns = {"opencode": self._llm_opencode, "ollama": self._llm_ollama,
               "openai": self._llm_openai}
        for name in order:
            t0 = time.time()
            out = fns[name](prompt)
            log(f"llm[{name}] elapse={time.time()-t0:.1f}s "
                f"len={len(out or '')} ok={bool(out)}")
            if out:
                return out
        return None

    def _llm_ollama(self, prompt):
        try:
            payload = {
                "model": OLLAMA_MODEL,
                "prompt": prompt,
                "stream": False,
                "options": {"temperature": 0.1, "num_predict": 1200,
                            "num_gpu": OLLAMA_GPU},
            }
            req = urllib.request.Request(
                api_endpoint(OLLAMA, "api/generate"),
                data=json.dumps(payload).encode(),
                headers={"Content-Type": "application/json"},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=OLLAMA_TIMEOUT) as r:
                data = json.loads(r.read().decode())
            try:
                ev = data.get("eval_count") or 0
                ed = data.get("eval_duration") or 1
                log(f"ollama: eval={ev}tok rate={ev/(ed/1e9):.1f} tok/s "
                    f"total={data.get('total_duration',0)/1e9:.1f}s "
                    f"load={data.get('load_duration',0)/1e9:.1f}s")
            except Exception:
                pass
            return (data.get("response") or "").strip() or None
        except Exception as e:
            log(f"ollama FAIL: {e}", "WARN")
            return None

    def _llm_openai(self, prompt):
        try:
            base = api_endpoint(API_BASE, "chat/completions")
            payload = {
                "model": API_MODEL,
                "messages": [
                    {"role": "system", "content":
                        "You are a helpful classical-music metadata assistant. "
                        "Reply ONLY with the requested JSON, no markdown."},
                    {"role": "user", "content": prompt},
                ],
                "temperature": 0.1,
                "max_tokens": 1200,
            }
            req = urllib.request.Request(
                base,
                data=json.dumps(payload).encode(),
                headers={"Content-Type": "application/json",
                         "Authorization": "Bearer " + API_KEY},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
                data = json.loads(r.read().decode())
            content = (data.get("choices") or [{}])[0].get("message", {}).get("content", "")
            return content.strip() or None
        except Exception as e:
            log(f"openai FAIL: {e}", "WARN")
            return None

    def _oc_health(self, port, timeout=2):
        try:
            with urllib.request.urlopen(
                    f"http://127.0.0.1:{port}/global/health", timeout=timeout) as r:
                return json.loads(r.read().decode()).get("healthy") is True
        except Exception:
            return False

    def _kill_pid(self, pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except Exception:
            return
        for _ in range(10):
            if not proc_alive(pid):
                return
            time.sleep(0.2)
        try:
            os.kill(pid, signal.SIGKILL)
        except Exception:
            pass

    def _oc_start(self, port):
        # Reclaim a wedged instance we spawned in a previous session instead of
        # stacking another `opencode serve` onto the same port.
        old_pid, old_port = read_pidfile()
        if old_pid and old_port == port and proc_alive(old_pid) \
                and not self._oc_health(port, timeout=3):
            log(f"stale opencode pid {old_pid} on :{port} wedged -> terminating", "WARN")
            self._kill_pid(old_pid)
            remove_pidfile()
        if port_in_use(port) and not self._oc_health(port, timeout=2):
            log(f":{port} held by an untracked listener and unhealthy; not spawning", "WARN")
            return False
        try:
            sd = open(SERVE_LOG, "a")
            self._oc_proc = subprocess.Popen(
                ["opencode", "serve", "--port", str(port), "--hostname", "127.0.0.1"],
                stdin=subprocess.DEVNULL, stdout=sd, stderr=sd)
            for _ in range(20):
                if self._oc_health(port):
                    write_pidfile(self._oc_proc.pid, port)
                    return True
                time.sleep(0.5)
            log(f"opencode serve on :{port} did not become healthy; see {SERVE_LOG}", "WARN")
            self._kill_pid(self._oc_proc.pid)
            remove_pidfile()
        except Exception as e:
            log(f"opencode spawn FAIL: {e}", "WARN")
        return False

    def _llm_opencode(self, prompt):
        port = oc_port()
        h0 = time.time()
        if not self._oc_health(port):
            log(f"opencode not on :{port}, spawning serve")
            if not self._oc_start(port):
                log("opencode unavailable", "WARN")
                return None
        log(f"opencode healthy (elapse={time.time()-h0:.1f}s), using :{port}")
        try:
            hdr = {"Content-Type": "application/json"}
            s0 = time.time()
            req = urllib.request.Request(
                f"http://127.0.0.1:{port}/session",
                data=json.dumps({"title": "mradio"}).encode(), headers=hdr, method="POST")
            with urllib.request.urlopen(req, timeout=10) as r:
                sid = json.loads(r.read().decode()).get("id")
            if not sid:
                log("opencode session create returned no id", "WARN")
                return None
            log(f"opencode session {sid} created in {time.time()-s0:.2f}s")
            try:
                m0 = time.time()
                req = urllib.request.Request(
                    f"http://127.0.0.1:{port}/session/{sid}/message",
                    data=json.dumps({"parts": [{"type": "text", "text": prompt}]}).encode(),
                    headers=hdr, method="POST")
                with urllib.request.urlopen(req, timeout=OC_TIMEOUT) as r:
                    data = json.loads(r.read().decode())
                texts = " ".join(
                    p.get("text", "") for p in data.get("parts", [])
                    if p.get("type") == "text" and p.get("text"))
                log(f"opencode message took {time.time()-m0:.1f}s, "
                    f"returned {len(data.get('parts') or [])} parts, {len(texts)} chars")
                return texts.strip() or None
            finally:
                try:
                    req = urllib.request.Request(
                        f"http://127.0.0.1:{port}/session/{sid}", method="DELETE")
                    urllib.request.urlopen(req, timeout=5)
                except Exception:
                    pass
        except Exception as e:
            log(f"opencode FAIL: {e}", "WARN")
            return None

    def shutdown(self):
        self.persist_cache()
        if getattr(self, "_oc_proc", None):
            try:
                self._oc_proc.terminate()
            except Exception:
                pass
            try:
                self._oc_proc.wait(timeout=2)
            except Exception:
                try:
                    self._oc_proc.kill()
                except Exception:
                    pass
            remove_pidfile()

    def _resolve_wiki(self, query, surname=""):
        ua = {"User-Agent": "mradio/0.3 (educational music enrichment) python-urllib"}
        cand = []
        try:
            qurl = ("https://en.wikipedia.org/w/api.php?action=opensearch&format=json"
                    "&limit=5&search=" + urllib.parse.quote(query))
            req = urllib.request.Request(qurl, headers=ua)
            with urllib.request.urlopen(req, timeout=10) as r:
                res = json.loads(r.read().decode())
            if len(res) > 3:
                cand.extend((res[1][i], res[3][i]) for i in range(min(len(res[1]), len(res[3]))))
        except Exception:
            pass
        if not cand:
            try:
                qurl = ("https://en.wikipedia.org/w/api.php?action=query&list=search&format=json"
                        "&srlimit=5&srsearch=" + urllib.parse.quote(query))
                req = urllib.request.Request(qurl, headers=ua)
                with urllib.request.urlopen(req, timeout=10) as r:
                    res = json.loads(r.read().decode())
                hits = res.get("query", {}).get("search", [])
                for h in hits:
                    t = h.get("title")
                    if not t:
                        continue
                    iurl = ("https://en.wikipedia.org/w/api.php?action=query&prop=info"
                            "&inprop=url&format=json&titles=" + urllib.parse.quote(t))
                    req = urllib.request.Request(iurl, headers=ua)
                    with urllib.request.urlopen(req, timeout=10) as r:
                        pages = json.loads(r.read().decode()).get("query", {}).get("pages", {})
                    for pg in pages.values():
                        if pg.get("fullurl"):
                            cand.append((pg.get("title", t), pg["fullurl"]))
            except Exception:
                pass
        seen = set()
        for t, u in cand:
            if u in seen:
                continue
            seen.add(u)
            if not self._relevant(u, t, query, surname):
                continue
            hreq = urllib.request.Request(u, method="HEAD", headers=ua)
            try:
                with urllib.request.urlopen(hreq, timeout=10) as r:
                    if r.status == 200:
                        return {"title": u.rsplit("/", 1)[-1].replace("_", " "),
                                "url": u}
            except Exception:
                continue
        return ""

    def _relevant(self, url, title, query, surname):
        try:
            eurl = ("https://en.wikipedia.org/w/api.php?action=query&prop=extracts"
                    "&exintro&explaintext&exchars=600&format=json&redirects=1&titles="
                    + urllib.parse.quote(title))
            ua = {"User-Agent": "mradio/0.3 (educational music enrichment) python-urllib"}
            req = urllib.request.Request(eurl, headers=ua)
            with urllib.request.urlopen(req, timeout=10) as r:
                res = json.loads(r.read().decode())
            pages = res.get("query", {}).get("pages", {})
            intro = ""
            for pg in pages.values():
                if "missing" not in pg:
                    intro = (pg.get("extract") or "")
                if pg.get("redirects"):
                    intro = intro or ""
            intro = intro.lower()
        except Exception:
            return False
        def toks(s):
            return set(re.findall(r"[a-zà-ÿ]+", s.lower()))
        qt = toks(query)
        tt = toks(title)
        if not qt or not tt:
            return False
        overlap = bool(qt & tt)
        surname_hit = (bool(surname) and surname.lower() in intro) or not surname
        return overlap and surname_hit

    def _pn(self, key):
        with self._lock:
            return self.last_key == key and key not in self.cache


def add(std, y, x, text, pair, attr=0):
    try:
        std.attron(curses.color_pair(pair) | attr)
        std.addstr(y, x, text)
        std.attroff(curses.color_pair(pair) | attr)
    except curses.error:
        pass


def draw_info(std, s, y, tw):
    if s["artist"]:
        add(std, y, 1, s["artist"][:tw], 4, curses.A_BOLD)
        y += 1
    add(std, y, 1, s["title"][:tw], 2, curses.A_BOLD)
    y += 1
    if s["performer"]:
