        "ollama_url": OLLAMA, "ollama_model": OLLAMA_MODEL,
        "ollama_timeout": OLLAMA_TIMEOUT, "ollama_gpu": OLLAMA_GPU,
        "api_base": API_BASE, "api_key": API_KEY, "api_model": API_MODEL,
