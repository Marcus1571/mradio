class Mpc:
    def __init__(self, path):
        self.path = path

    def cmd(self, *args):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(0.4)
            s.connect(self.path)
            s.sendall(json.dumps({"command": list(args)}).encode() + b"\n")
            buf = b""
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
                if buf.count(b"\n") >= 1:
                    break
            s.close()
            return json.loads(buf.split(b"\n")[0])
        except Exception:
            return None

    def get(self, prop):
        r = self.cmd("get_property", prop)
        if isinstance(r, dict) and r.get("error") == "success":
            return r.get("data")
        return None


def repair_mojibake(s):
    for enc in ("cp1252", "latin-1"):
        try:
            fixed = s.encode(enc).decode("utf-8")
            if fixed != s:
                return fixed
        except Exception:
            continue
    return s


def elide(s, limit=4000):
    s = " ".join(s.split())
    if len(s) <= limit:
        return s
    cut = s[:limit].rsplit(" ", 1)[0]
    return cut.rstrip(" ,;:-") + "…"


def ver_key(v):
    return [int(x) for x in re.findall(r"\d+", v or "")]


def latest_release_version(body):
    tags = re.findall(r"releases/tag/v?([0-9]+(?:\.[0-9]+){1,3})", body or "")
    return tags[0] if tags else None


def latest_release_tag(body):
    tags = re.findall(r"releases/tag/([^\"'<>]+)", body or "")
    return tags[0].rstrip("/") if tags else None


def check_update():
    """Fetch the newest release tag from the GitHub releases atom feed.

    Runs periodically in a background daemon thread. Reports only — it never
    downloads or runs code. Uses a conditional request: after the first check
    the feed's ETag is sent back (If-None-Match), so an unchanged feed returns
    a cheap 304 that does not count against GitHub's rate limits. GitHub's
    unauthenticated REST limit is 60 req/hr; hourly polling (24/day) plus
    ETags is ~0 effective requests for a typical week. On completion
    _latest["note"] holds a one-line result (shown when `v` is pressed)."""
    with _check_lock:
        try:
            headers = {"User-Agent": "mradio/" + VERSION}
            if _latest["etag"]:
                headers["If-None-Match"] = _latest["etag"]
            req = urllib.request.Request(
                f"https://github.com/{UPDATE_REPO}/releases.atom",
                headers=headers)
            with urllib.request.urlopen(req, timeout=6) as r:
                _latest["etag"] = r.headers.get("ETag") or _latest["etag"]
                body = r.read().decode("utf-8", "replace")
            _latest["tag"] = latest_release_tag(body)
            _latest["version"] = latest_release_version(body)
            log(f"update check: latest={_latest['version']} current={VERSION}")
            v = _latest["version"]
            if v and ver_key(v) > ver_key(VERSION):
                _latest["note"] = f"new version v{v} — press U"
            else:
                _latest["note"] = f"up to date (v{VERSION})"
        except urllib.error.HTTPError as e:
            if e.code == 304:
                log("update check: unchanged (304)")
                v = _latest["version"]
                if v and ver_key(v) > ver_key(VERSION):
                    _latest["note"] = f"new version v{v} — press U"
                else:
                    _latest["note"] = f"up to date (v{VERSION})"
            else:
                log(f"update check FAIL: {e}", "WARN")
                _latest["note"] = "check failed"
        except Exception as e:
            log(f"update check FAIL: {e}", "WARN")
            _latest["note"] = "check failed"


def force_check(state):
    """One-off background update check for the `v` key.

    Flashes the result in the AI row via state["update_msg"]. Requests are
    kept serial (GitHub best practice): if a check is already in flight this
    only reports that instead of stacking a concurrent one."""
    if not _forced_lock.acquire(blocking=False):
        state["update_msg"] = "update check already running…"
        state["update_msg_t"] = time.time()
        return

    def run():
        try:
            state["update_msg"] = "checking for updates…"
            state["update_msg_t"] = time.time()
            check_update()
            note = _latest.get("note")
            if note:
                if state.get("update_pending"):
                    note = "updated to v" + (_latest.get("version") or "?") + \
                        " — restart to apply"
                state["update_msg"] = note
                state["update_msg_t"] = time.time()
        finally:
            _forced_lock.release()

    threading.Thread(target=run, daemon=True).start()


def update_watcher():
    """Check for new releases immediately, then again every UPDATE_INTERVAL."""
    while True:
        check_update()
        time.sleep(UPDATE_INTERVAL)


def apply_update():
    """Download the newest release's mradio asset, validate it, back up the
    running script and atomically swap it in place.

    The downloaded code is NEVER executed — it only replaces the file on disk,
    so the change takes effect on the next restart. Returns (ok, message). Any
    web/failure path returns ok=False so the caller can fall back to the
    release page. A release cut without a mradio asset simply fails this way."""
    tag = _latest.get("tag")
    new_ver = _latest.get("version")
    if not tag or not new_ver or ver_key(new_ver) <= ver_key(VERSION):
        return False, "no newer release"
    script = os.path.realpath(__file__)
    here = os.path.dirname(script)
    if os.path.isdir(os.path.join(here, ".git")):
        return False, "running from a source checkout — use git pull"
    if not os.access(here, os.W_OK):
        return False, f"{here} is not writable"
    url = f"https://github.com/{UPDATE_REPO}/releases/download/{tag}/mradio"
    tmp = script + ".new"
    try:
        req = urllib.request.Request(url,
                                     headers={"User-Agent": "mradio/" + VERSION})
        with urllib.request.urlopen(req, timeout=20) as r:
            body = r.read()
    except Exception as e:
        log(f"self-update download FAIL: {e}", "WARN")
        return False, "download failed"
    if not body:
        return False, "download was empty"
    text = body.decode("utf-8", "replace")
    m = re.search(r'^VERSION\s*=\s*"([^"]+)"', text, re.M)
    got = m.group(1) if m else ""
    if not got or ver_key(got) != ver_key(new_ver):
        return False, f"downloaded version {got or '?'} != {new_ver}"
    try:
        compile(text, "mradio self-update", "exec")
    except SyntaxError as e:
        return False, f"downloaded file failed syntax check: {e}"
    try:
        with open(tmp, "wb") as fh:
            fh.write(body)
    except OSError as e:
        log(f"self-update write FAIL: {e}", "WARN")
        return False, "cannot write staging file"
    backup = script + ".old"
    try:
        os.replace(script, backup)
    except OSError as e:
        log(f"self-update backup FAIL: {e}", "WARN")
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False, f"cannot move current file aside: {e}"
    try:
        os.replace(tmp, script)
        os.chmod(script, 0o755)
    except OSError as e:
        try:
            os.replace(backup, script)
        except OSError:
            pass
        log(f"self-update swap FAIL: {e}", "WARN")
        return False, f"swap failed: {e}"
    log(f"self-update: {VERSION} -> {new_ver} (asset {tag})")
    return True, f"updated to v{new_ver} — restart mradio to apply"


def extract_json_item(raw):
    item = {"work": "", "trivia": "", "wiki": "", "movement": 0}
    r = re.sub(r"^```(?:json)?\s*", "", raw.strip())
    r = re.sub(r"\s*```$", "", r)
    a, b = r.find("{"), r.rfind("}")
    if a != -1 and b > a:
        try:
            p = json.loads(r[a:b + 1])
            if isinstance(p, dict):
                return {
                    "work": str(p.get("work") or "").strip(),
                    "trivia": str(p.get("trivia") or "").strip(),
                    "wiki": str(p.get("wiki") or "").strip(),
                    "movement": 1 if p.get("movement") == 1 else 0,
                }
        except Exception:
            pass

    def g(key):
        m = re.search(rf'"{re.escape(key)}"\s*:\s*"((?:[^"\\]|\\.)*)"', r)
        if m:
            v = m.group(1).replace('\\"', '"').replace("\\n", " ")
            v = v.replace("\\u2019", "’").replace("\\u2018", "‘")
            return v
        return None

    trivia, wiki, work = g("trivia"), g("wiki"), g("work")
    mm = re.search(r'"movement"\s*:\s*([01])', r)
    got = [v for v in (trivia, wiki, work) if v is not None] or (mm is not None)
    if got:
        item["trivia"] = trivia or ""
        item["wiki"] = wiki or ""
        item["work"] = work or ""
        item["movement"] = 1 if (mm and mm.group(1) == "1") else 0
        return item
    if re.search(r"\b(movement|tagged name|json|schema)\b", r, re.I):
        return item
    item["trivia"] = elide(" ".join(r.split()))
    return item


def split_title(raw):
    raw = repair_mojibake(raw)
    raw = re.sub(r"\s*\{[^}]*\}", "", raw).strip()
    artist, sep, title = raw.partition(" - ")
    if not sep:
        artist, title = "", raw
    performer = ""
    i = title.find("(")
    if i != -1:
        candidate = title[i:].strip()
        if candidate.endswith(")") and len(candidate) > 2:
            performer = candidate
            title = title[:i].strip()
    return artist, title.strip(), performer


def meter(width, value, nmax):
    if nmax <= 0:
        return " " * width
    filled = int(round(width * min(value, nmax) / nmax))
    return "█" * filled + "░" * (width - filled)


