def eff_str(env, key, fallback):
    v = os.environ.get(env)
    if v is not None and v != "":
        return v
    v = SETTINGS.get(key)
    return fallback if v is None else str(v)


def eff_int(env, key, fallback):
    v = eff_str(env, key, fallback)
    try:
        return int(v)
    except (TypeError, ValueError):
        return fallback


