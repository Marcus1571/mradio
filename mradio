        tmp = STATIONS_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump({"favorites": list(lst)}, fh, indent=2)
        os.replace(tmp, STATIONS_FILE)
        return True
    except Exception as e:
        log(f"favorites save FAIL: {e}", "WARN")
        return False


