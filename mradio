def seed_settings(force=False):
    values = {
        "ollama_url": OLLAMA, "ollama_model": OLLAMA_MODEL,
        "ollama_timeout": OLLAMA_TIMEOUT, "ollama_gpu": OLLAMA_GPU,
        "api_base": API_BASE, "api_key": API_KEY, "api_model": API_MODEL,
        "api_timeout": API_TIMEOUT, "opencode": OC, "opencode_timeout": OC_TIMEOUT,
    }
    if not force and load_settings():
        return
    try:
        os.makedirs(os.path.dirname(SETTINGS_FILE), exist_ok=True)
        tmp = SETTINGS_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(values, fh, indent=2)
        os.replace(tmp, SETTINGS_FILE)
        log(f"settings seeded to {SETTINGS_FILE}")
    except Exception as e:
        log(f"settings seed FAIL: {e}", "WARN")


def eff_str(env, key, fallback):
    v = os.environ.get(env)
    if v is not None and v != "":
        return v
    v = SETTINGS.get(key)
    return fallback if v is None else str(v)


def eff_int(env, key, fallback):
    v = eff_str(env, key, fallback)
    try:
        return int(v)
    except (TypeError, ValueError):
        return fallback


